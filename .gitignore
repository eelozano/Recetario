# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Local data / secrets
*.db
.env
.recetario/
# Default flat-file data dir ($DOCUMENT/Recetario/data). In dev this repo lives
# at ~/Documents/Recetario, so the app's default store lands at ./data — keep the
# runtime recipes/calendar/shopping out of git. Anchored so desktop/src/data/ (the
# composition root) is NOT ignored.
/data/

# Node / Tauri
node_modules/
desktop/src-tauri/target/
dist/

# Build artifacts
# PyInstaller working dir and the frozen sidecar binary (regenerated per-arch by
# desktop/scripts/build-sidecar.sh — large and machine-specific, never committed).
backend/build/
desktop/src-tauri/binaries/

# Claude Code local (machine-specific) settings
.claude/settings.local.json
