# Recetario backend configuration.
#
# Copy this file to `.env` (same directory) and fill in real values. Every var is
# prefixed with RECETARIO_; the app also reads matching shell environment vars.
# `.env` is gitignored — never commit real keys.

# --- Database ---------------------------------------------------------------
# Default is a local SQLite file at ~/.recetario/recetario.db. Swap to Postgres
# for the cloud migration, e.g.
#   RECETARIO_DATABASE_URL=postgresql+psycopg://user:pass@host/db
#RECETARIO_DATABASE_URL=sqlite:////absolute/path/to/recetario.db

# --- API server -------------------------------------------------------------
#RECETARIO_API_HOST=127.0.0.1
#RECETARIO_API_PORT=8765

# --- USDA FoodData Central --------------------------------------------------
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Needed for the nutrition seeder and for the USDA-matching half of LLM ingestion.
RECETARIO_FDC_API_KEY=

# --- Anthropic (LLM ingestion) ---------------------------------------------
# When set ALONGSIDE RECETARIO_FDC_API_KEY, URL ingestion runs an extra LLM pass
# that parses ingredient quantities/units and matches each line to a USDA food.
# Without it, ingestion uses the deterministic scraper only.
RECETARIO_ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-7).
#RECETARIO_ANTHROPIC_MODEL=claude-opus-4-7
