{
  "name": "@recetario/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable, framework-free domain core (entities + services). Shared by the desktop shell now and a future React Native app. No network, no filesystem, no Node-only APIs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/storage/adapters/node-fs.d.ts",
      "default": "./dist/storage/adapters/node-fs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "js-yaml": "^4.1.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.0",
    "typescript": "~5.8.3",
    "vitest": "^4.0.0"
  }
}
